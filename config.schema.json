{
  "pluginAlias": "EufyClean",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Controls Eufy Clean robot vacuums through Eufy's cloud MQTT broker. Requires Homebridge 2.0+ with Matter enabled.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Eufy Clean"
      },
      "email": {
        "title": "Eufy account email",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "Eufy account password",
        "type": "string",
        "required": true
      },
      "pollIntervalSeconds": {
        "title": "Poll interval (seconds)",
        "type": "integer",
        "description": "How often to re-read the cloud device list so an idle vacuum's battery and status stay fresh.",
        "default": 60,
        "minimum": 10
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "deviceId": {
              "title": "Device ID (device_sn)",
              "type": "string",
              "required": true
            },
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rooms": {
              "title": "Rooms",
              "description": "Give each entry a Room ID or a Scene ID, never both.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "required": true
                  },
                  "roomId": {
                    "title": "Room ID",
                    "type": "integer"
                  },
                  "sceneId": {
                    "title": "Scene ID",
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": ["email", "password"]
  },
  "form": [
    "email",
    "password",
    "pollIntervalSeconds",
    {
      "key": "devices",
      "type": "array",
      "title": "Devices (leave empty to expose every MQTT vacuum on the account)",
      "items": [
        "devices[].deviceId",
        "devices[].name",
        {
          "key": "devices[].rooms",
          "type": "array",
          "title": "Rooms / scenes",
          "items": [
            "devices[].rooms[].name",
            "devices[].rooms[].roomId",
            "devices[].rooms[].sceneId"
          ]
        }
      ]
    }
  ]
}
